<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
  <!--
    Test classes that hold only static fixtures (ArchUnit rule holders, header constants) look
    like utility classes to Checkstyle but are instantiated by the test engine.
  -->
  <suppress checks="HideUtilityClassConstructor" files=".*ModuleBoundaryTest\.java"/>
</suppressions>
